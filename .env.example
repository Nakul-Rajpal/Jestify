# Database
DATABASE_URL=postgresql+asyncpg://jestify:devpassword@localhost:5432/jestify

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic (Claude API for script generation)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Fish Audio
FISH_API_KEY=fish-xxxxx
FISH_MODEL=s1
FISH_TIMEOUT_SECONDS=20
FISH_VOICE_ID_LEBRON=
FISH_VOICE_ID_GOKU=
FISH_VOICE_ID_PETER=
FISH_VOICE_ID_TAYLOR=
# Optional: when a selected Fish voice fails, try this voice id next.
FISH_FALLBACK_VOICE_ID=
# If true, only the selected Fish voice ID is attempted.
STRICT_SELECTED_VOICE_ONLY=true
# Prefer env-configured fish IDs over hardcoded personality defaults.
USE_PERSONALITY_FISH_IDS=false
# Keep false to preserve character identity (Peter won't fall back to LeBron voice).
ALLOW_CROSS_CHARACTER_VOICE_FALLBACK=false
# Comma-separated characters that must use Fish voice (e.g. peter,taylor).
REQUIRE_FISH_VOICE_FOR_CHARACTERS=peter
# If false, failed TTS raises an error instead of writing silent audio.
ALLOW_SILENT_FALLBACK=false

# Generation tuning (scene count, scene duration, and code budget)
FAST_GENERATION_MODE=true
ENABLE_CONTEXT7_DOCS=false
MAX_SOURCE_CHARS=6000
FAST_TARGET_SCENES=5
FAST_MIN_SCENE_SECONDS=18
FAST_MAX_SCENE_SECONDS=24
FAST_CODE_MAX_TOKENS=8192
MAX_RENDER_WORKERS=5
MAX_VOICE_WORKERS=8
MAX_COMPOSITE_WORKERS=4
MANIM_FPS=12

# Context7 (live Manim documentation)
CONTEXT7_API_KEY=ctx7sk-xxxxx

# Storage
STORAGE_PATH=./storage

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
